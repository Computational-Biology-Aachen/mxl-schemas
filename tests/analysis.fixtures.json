          }
         },
         {
          "edits": [
           {
            "clampVariable": "x",
            "to": 0.5
           }
          ],
          "simulate": {
           "kind": "timeCourse",
           "tEval": [
            0,
            5
           ]
          }
         }
        ]
       }
      }
     },
     {
      "id": "scan",
      "simulate": {
       "kind": "steadyState"
      },
      "scans": {
       "s": {
        "over": {
         "k": [
          1,
          2,
          3
         ],
         "L": [
          0
         ]
        },
        "columns": [
         "x",
         "v1"
        ]
       },
       "g": {
        "over": {
         "a": [
          1,
          2
         ],
         "b": [
          3,
          4
         ]
        },
        "grid": true,
        "x": [
         0,
         1,
         2,
         3
        ],
        "columns": [
         "x"
        ],
        "edits": [
         {
          "addParameter": "a",
          "value": 0
         },
         {
          "setAssignment": "d",
          "to": "a * b"
         }
        ],
        "simulate": {
         "kind": "timeCourse",
         "tEval": [
          100
         ]
        }
       }
      },
      "plots": [
       {
        "type": "heatmap",
        "rows": [
         "a"
        ],
        "columns": [
         "b"
        ],
        "z": [
         [
          "nth(g.x, 0)"
         ]
        ]
       }
      ]
     },
     {
      "id": "control",
      "mca": {
       "rc": {
        "type": "responseCoefficients",
        "wrt": [
         "k"
        ],
        "outputs": [
         "x",
         "v1"
        ],
        "set": {
         "L": 100
        },
        "displacement": 0.01
       },
       "ve": {
        "type": "variableElasticities",
        "wrt": [
         "x"
        ],
        "outputs": [
         "v1"
        ],
        "at": "steadyState"
       },
       "pe": {
        "type": "parameterElasticities",
        "wrt": [
         "k"
        ],
        "outputs": [
         "v1"
        ],
        "normalized": false
       }
      },
      "stability": {
       "ss": {
        "set": {
         "L": 100
        }
       }
      },
      "derive": {
       "stable": "ifgt(max(ss.real), 0, 0, 1)"
      },
      "plots": [
       {
        "type": "scatter",
        "series": [
         {
          "x": "ss.real",
          "y": "ss.imag"
         }
        ]
       },
       {
        "type": "stackedBar",
        "categories": [
         "k"
        ],
        "stacks": [
         {
          "label": "x",
          "of": [
           "nth(rc.x, 0)"
          ]
         }
        ]
       }
      ]
     }
    ]
